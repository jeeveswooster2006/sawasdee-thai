[
 {
  "level": "Sounds of Spanish",
  "units": [
   {
    "id": "es-sp-vowels",
    "title": "The five vowels",
    "tagline": "Short, pure sounds that never change.",
    "lessons": [
     {
      "id": "es-sp-vowels-1",
      "title": "A, E, I, O, U",
      "words": [
       {
        "id": "es-sp-vowel-a",
        "kind": "letter",
        "text": "A a",
        "roman": "ah",
        "en": "ah, as in agua (water)",
        "emoji": "💧",
        "say": "a, agua",
        "note": "Spanish vowels are short and pure: they never slide into another sound like English 'oh-oo'."
       },
       {
        "id": "es-sp-vowel-e",
        "kind": "letter",
        "text": "E e",
        "roman": "eh",
        "en": "eh, as in elefante (elephant)",
        "emoji": "🐘",
        "say": "e, elefante",
        "note": "Spanish vowels are short and pure: they never slide into another sound like English 'oh-oo'."
       },
       {
        "id": "es-sp-vowel-i",
        "kind": "letter",
        "text": "I i",
        "roman": "ee",
        "en": "ee, as in isla (island)",
        "emoji": "🏝️",
        "say": "i, isla",
        "note": "Spanish vowels are short and pure: they never slide into another sound like English 'oh-oo'."
       },
       {
        "id": "es-sp-vowel-o",
        "kind": "letter",
        "text": "O o",
        "roman": "oh",
        "en": "oh, as in oso (bear)",
        "emoji": "🐻",
        "say": "o, oso",
        "note": "Spanish vowels are short and pure: they never slide into another sound like English 'oh-oo'."
       },
       {
        "id": "es-sp-vowel-u",
        "kind": "letter",
        "text": "U u",
        "roman": "oo",
        "en": "oo, as in uva (grape)",
        "emoji": "🍇",
        "say": "u, uva",
        "note": "Spanish vowels are short and pure: they never slide into another sound like English 'oh-oo'."
       }
      ]
     }
    ]
   },
   {
    "id": "es-sp-abc",
    "title": "The alphabet",
    "tagline": "27 letters and their names.",
    "lessons": [
     {
      "id": "es-sp-abc-1",
      "title": "B to H",
      "words": [
       {
        "id": "es-sp-abc-b",
        "kind": "letter",
        "text": "B b",
        "name": "be",
        "roman": "beh",
        "en": "“be”, as in barco (boat)",
        "emoji": "⛵",
        "say": "be, barco",
        "note": "The letter is called “be” (beh). Barco means boat."
       },
       {
        "id": "es-sp-abc-c",
        "kind": "letter",
        "text": "C c",
        "name": "ce",
        "roman": "theh",
        "en": "“ce”, as in casa (house)",
        "emoji": "🏠",
        "say": "ce, casa",
        "note": "The letter is called “ce” (theh). Casa means house."
       },
       {
        "id": "es-sp-abc-d",
        "kind": "letter",
        "text": "D d",
        "name": "de",
        "roman": "deh",
        "en": "“de”, as in dedo (finger)",
        "emoji": "☝️",
        "say": "de, dedo",
        "note": "The letter is called “de” (deh). Dedo means finger."
       },
       {
        "id": "es-sp-abc-f",
        "kind": "letter",
        "text": "F f",
        "name": "efe",
        "roman": "EH-feh",
        "en": "“efe”, as in fresa (strawberry)",
        "emoji": "🍓",
        "say": "efe, fresa",
        "note": "The letter is called “efe” (EH-feh). Fresa means strawberry."
       },
       {
        "id": "es-sp-abc-g",
        "kind": "letter",
        "text": "G g",
        "name": "ge",
        "roman": "heh",
        "en": "“ge”, as in gato (cat)",
        "emoji": "🐱",
        "say": "ge, gato",
        "note": "The letter is called “ge” (heh). Gato means cat."
       },
       {
        "id": "es-sp-abc-h",
        "kind": "letter",
        "text": "H h",
        "name": "hache",
        "roman": "AH-cheh",
        "en": "“hache”, as in helado (ice cream)",
        "emoji": "🍦",
        "say": "hache, helado",
        "note": "The letter is called “hache” (AH-cheh), but h is always silent: helado sounds like eh-LAH-doh."
       }
      ]
     },
     {
      "id": "es-sp-abc-2",
      "title": "J to Ñ",
      "words": [
       {
        "id": "es-sp-abc-j",
        "kind": "letter",
        "text": "J j",
        "name": "jota",
        "roman": "HOH-tah",
        "en": "“jota”, as in jirafa (giraffe)",
        "emoji": "🦒",
        "say": "jota, jirafa",
        "note": "The letter is called “jota” (HOH-tah). Jirafa means giraffe."
       },
       {
        "id": "es-sp-abc-k",
        "kind": "letter",
        "text": "K k",
        "name": "ka",
        "roman": "kah",
        "en": "“ka”, as in kiwi (kiwi)",
        "emoji": "🥝",
        "say": "ka, kiwi",
        "note": "The letter is called “ka” (kah). Kiwi means kiwi."
       },
       {
        "id": "es-sp-abc-l",
        "kind": "letter",
        "text": "L l",
        "name": "ele",
        "roman": "EH-leh",
        "en": "“ele”, as in luna (moon)",
        "emoji": "🌙",
        "say": "ele, luna",
        "note": "The letter is called “ele” (EH-leh). Luna means moon."
       },
       {
        "id": "es-sp-abc-m",
        "kind": "letter",
        "text": "M m",
        "name": "eme",
        "roman": "EH-meh",
        "en": "“eme”, as in mano (hand)",
        "emoji": "✋",
        "say": "eme, mano",
        "note": "The letter is called “eme” (EH-meh). Mano means hand."
       },
       {
        "id": "es-sp-abc-n",
        "kind": "letter",
        "text": "N n",
        "name": "ene",
        "roman": "EH-neh",
        "en": "“ene”, as in nube (cloud)",
        "emoji": "☁️",
        "say": "ene, nube",
        "note": "The letter is called “ene” (EH-neh). Nube means cloud."
       },
       {
        "id": "es-sp-abc-nn",
        "kind": "letter",
        "text": "Ñ ñ",
        "name": "eñe",
        "roman": "EH-nyeh",
        "en": "“eñe”, as in niño (child)",
        "emoji": "🧒",
        "say": "eñe, niño",
        "note": "Ñ is its own letter, called “eñe” (EH-nyeh). It sounds like the ny in canyon."
       }
      ]
     },
     {
      "id": "es-sp-abc-3",
      "title": "P to T",
      "words": [
       {
        "id": "es-sp-abc-p",
        "kind": "letter",
        "text": "P p",
        "name": "pe",
        "roman": "peh",
        "en": "“pe”, as in perro (dog)",
        "emoji": "🐶",
        "say": "pe, perro",
        "note": "The letter is called “pe” (peh). Perro means dog."
       },
       {
        "id": "es-sp-abc-q",
        "kind": "letter",
        "text": "Q q",
        "name": "cu",
        "roman": "koo",
        "en": "“cu”, as in queso (cheese)",
        "emoji": "🧀",
        "say": "cu, queso",
        "note": "The letter is called “cu” (koo). Q is always followed by a silent u: queso sounds like KEH-soh."
       },
       {
        "id": "es-sp-abc-r",
        "kind": "letter",
        "text": "R r",
        "name": "erre",
        "roman": "EH-rreh",
        "en": "“erre”, as in ratón (mouse)",
        "emoji": "🐭",
        "say": "erre, ratón",
        "note": "The letter is called “erre”. At the start of a word r is rolled, like rr."
       },
       {
        "id": "es-sp-abc-s",
        "kind": "letter",
        "text": "S s",
        "name": "ese",
        "roman": "EH-seh",
        "en": "“ese”, as in sol (sun)",
        "emoji": "☀️",
        "say": "ese, sol",
        "note": "The letter is called “ese” (EH-seh). Sol means sun."
       },
       {
        "id": "es-sp-abc-t",
        "kind": "letter",
        "text": "T t",
        "name": "te",
        "roman": "teh",
        "en": "“te”, as in tomate (tomato)",
        "emoji": "🍅",
        "say": "te, tomate",
        "note": "The letter is called “te” (teh). Tomate means tomato."
       }
      ]
     },
     {
      "id": "es-sp-abc-4",
      "title": "V to Z",
      "words": [
       {
        "id": "es-sp-abc-v",
        "kind": "letter",
        "text": "V v",
        "name": "uve",
        "roman": "OO-beh",
        "en": "“uve”, as in vaca (cow)",
        "emoji": "🐄",
        "say": "uve, vaca",
        "note": "The letter is called “uve” in Spain. V sounds just like b: vaca sounds like BAH-kah."
       },
       {
        "id": "es-sp-abc-w",
        "kind": "letter",
        "text": "W w",
        "name": "uve doble",
        "roman": "OO-beh DOH-bleh",
        "en": "“uve doble”, as in wifi (Wi-Fi)",
        "emoji": "📶",
        "say": "uve doble, wifi",
        "note": "“Uve doble” means double v. W only appears in borrowed words like wifi."
       },
       {
        "id": "es-sp-abc-x",
        "kind": "letter",
        "text": "X x",
        "name": "equis",
        "roman": "EH-kees",
        "en": "“equis”, as in taxi (taxi)",
        "emoji": "🚕",
        "say": "equis, taxi",
        "note": "The letter is called “equis” (EH-kees). Taxi means taxi."
       },
       {
        "id": "es-sp-abc-y",
        "kind": "letter",
        "text": "Y y",
        "name": "ye",
        "roman": "yeh",
        "en": "“ye”, as in yogur (yoghurt)",
        "emoji": "🥛",
        "say": "ye, yogur",
        "note": "The letter is called “ye” (yeh); older people may say “i griega”. On its own, y means and."
       },
       {
        "id": "es-sp-abc-z",
        "kind": "letter",
        "text": "Z z",
        "name": "zeta",
        "roman": "THEH-tah",
        "en": "“zeta”, as in zapato (shoe)",
        "emoji": "👟",
        "say": "zeta, zapato",
        "note": "The letter is called “zeta”. In Spain z sounds like th in think: thah-PAH-toh."
       }
      ]
     }
    ]
   },
   {
    "id": "es-sp-tricky",
    "title": "Tricky sounds",
    "tagline": "The sounds English speakers mix up.",
    "lessons": [
     {
      "id": "es-sp-tricky-1",
      "title": "Ñ, LL, R, RR and CH",
      "words": [
       {
        "id": "es-sp-sound-ny",
        "kind": "sound",
        "text": "ñ",
        "roman": "ny",
        "en": "ny, as in España (Spain)",
        "emoji": "🇪🇸",
        "say": "España",
        "note": "Like the ny in canyon: es-PAH-nyah."
       },
       {
        "id": "es-sp-sound-ll",
        "kind": "sound",
        "text": "ll",
        "roman": "y",
        "en": "y, as in llave (key)",
        "emoji": "🔑",
        "say": "llave",
        "note": "In most of Spain ll sounds like the y in yes: YAH-beh."
       },
       {
        "id": "es-sp-sound-r",
        "kind": "sound",
        "text": "r",
        "roman": "tapped r",
        "en": "a quick tap, as in pero (but)",
        "emoji": "↔️",
        "say": "pero",
        "note": "Between vowels, one r is a single quick tap of the tongue, like the tt in American butter."
       },
       {
        "id": "es-sp-sound-rr",
        "kind": "sound",
        "text": "rr",
        "roman": "rolled r",
        "en": "a rolled r, as in perro (dog)",
        "emoji": "🐶",
        "say": "perro",
        "note": "Roll your tongue for rr. Pero (but) and perro (dog) only differ by the roll!"
       },
       {
        "id": "es-sp-sound-ch",
        "kind": "sound",
        "text": "ch",
        "roman": "ch",
        "en": "ch, as in chocolate (chocolate)",
        "emoji": "🍫",
        "say": "chocolate",
        "note": "Just like English ch in church."
       }
      ]
     },
     {
      "id": "es-sp-tricky-2",
      "title": "C, Z and QU in Spain",
      "words": [
       {
        "id": "es-sp-sound-ca",
        "kind": "sound",
        "text": "ca · co · cu",
        "roman": "k",
        "en": "k, as in coche (car)",
        "emoji": "🚗",
        "say": "coche",
        "note": "Before a, o or u, c is a k sound: KOH-cheh."
       },
       {
        "id": "es-sp-sound-ce",
        "kind": "sound",
        "text": "ce · ci",
        "roman": "th",
        "en": "th, as in cinco (five)",
        "emoji": "🖐️",
        "say": "cinco",
        "note": "In Spain, c before e or i sounds like th in think: THEEN-koh."
       },
       {
        "id": "es-sp-sound-z",
        "kind": "sound",
        "text": "z",
        "roman": "th",
        "en": "th, as in zumo (juice)",
        "emoji": "🧃",
        "say": "zumo",
        "note": "In Spain z also sounds like th in think: THOO-moh."
       },
       {
        "id": "es-sp-sound-qu",
        "kind": "sound",
        "text": "que · qui",
        "roman": "k",
        "en": "k, as in queso (cheese)",
        "emoji": "🧀",
        "say": "queso",
        "note": "The u after q is silent: KEH-soh."
       }
      ]
     },
     {
      "id": "es-sp-tricky-3",
      "title": "J, G and the silent H",
      "words": [
       {
        "id": "es-sp-sound-j",
        "kind": "sound",
        "text": "j",
        "roman": "throaty h",
        "en": "a throaty h, as in jamón (ham)",
        "emoji": "🍖",
        "say": "jamón",
        "note": "Breathe it from the back of your throat, like ch in Scottish loch: hah-MON."
       },
       {
        "id": "es-sp-sound-ge",
        "kind": "sound",
        "text": "ge · gi",
        "roman": "throaty h",
        "en": "a throaty h, as in gente (people)",
        "emoji": "👥",
        "say": "gente",
        "note": "Before e or i, g sounds like j: HEN-teh."
       },
       {
        "id": "es-sp-sound-ga",
        "kind": "sound",
        "text": "ga · go · gu",
        "roman": "g",
        "en": "a hard g, as in gafas (glasses)",
        "emoji": "👓",
        "say": "gafas",
        "note": "Before a, o or u, g is a hard g, as in go."
       },
       {
        "id": "es-sp-sound-gue",
        "kind": "sound",
        "text": "gue · gui",
        "roman": "g",
        "en": "a hard g, as in guitarra (guitar)",
        "emoji": "🎸",
        "say": "guitarra",
        "note": "The u is silent here, it just keeps the g hard: gee-TAH-rrah."
       },
       {
        "id": "es-sp-sound-h",
        "kind": "sound",
        "text": "h",
        "roman": "silent",
        "en": "silent, as in hola (hello)",
        "emoji": "👋",
        "say": "hola",
        "note": "H is never pronounced: OH-lah."
       }
      ]
     }
    ]
   },
   {
    "id": "es-sp-accents",
    "title": "Accents and marks",
    "tagline": "Little marks that change the sound or meaning.",
    "lessons": [
     {
      "id": "es-sp-accents-1",
      "title": "Where's the stress?",
      "words": [
       {
        "id": "es-sp-word-casa",
        "kind": "word",
        "text": "casa",
        "roman": "KAH-sah",
        "en": "house (stress on CA)",
        "emoji": "🏠",
        "say": "casa",
        "note": "No accent? Words ending in a vowel, n or s stress the second-last syllable; others stress the last. An accent overrides the rule."
       },
       {
        "id": "es-sp-word-cafe",
        "kind": "word",
        "text": "café",
        "roman": "kah-FEH",
        "en": "coffee (stress on FÉ)",
        "emoji": "☕",
        "say": "café",
        "note": "The accent on é moves the stress to the end: kah-FEH."
       },
       {
        "id": "es-sp-word-arbol",
        "kind": "word",
        "text": "árbol",
        "roman": "AR-bol",
        "en": "tree (stress on ÁR)",
        "emoji": "🌳",
        "say": "árbol",
        "note": "The accent on á puts the stress on the first syllable."
       },
       {
        "id": "es-sp-word-musica",
        "kind": "word",
        "text": "música",
        "roman": "MOO-see-kah",
        "en": "music (stress on MÚ)",
        "emoji": "🎵",
        "say": "música",
        "note": "The accent on ú puts the stress on MÚ."
       },
       {
        "id": "es-sp-word-avion",
        "kind": "word",
        "text": "avión",
        "roman": "ah-bee-ON",
        "en": "plane (stress on ÓN)",
        "emoji": "✈️",
        "say": "avión",
        "note": "The accent on ó puts the stress at the end."
       }
      ]
     },
     {
      "id": "es-sp-accents-2",
      "title": "Special marks",
      "words": [
       {
        "id": "es-sp-mark-que",
        "kind": "mark",
        "text": "¿Qué?",
        "roman": "keh",
        "en": "What? (¿ opens a question)",
        "emoji": "❓",
        "say": "¿Qué?",
        "note": "Spanish questions start with an upside-down ¿ and end with ?."
       },
       {
        "id": "es-sp-mark-hola",
        "kind": "mark",
        "text": "¡Hola!",
        "roman": "OH-lah",
        "en": "Hello! (¡ opens an exclamation)",
        "emoji": "🎉",
        "say": "¡Hola!",
        "note": "Exclamations start with an upside-down ¡ and end with !."
       },
       {
        "id": "es-sp-mark-pinguino",
        "kind": "mark",
        "text": "pingüino",
        "roman": "peen-GWEE-noh",
        "en": "penguin (ü: say the u)",
        "emoji": "🐧",
        "say": "pingüino",
        "note": "The two dots on ü mean you do say the u: gwee, not gee."
       },
       {
        "id": "es-sp-mark-si",
        "kind": "mark",
        "text": "sí",
        "roman": "see",
        "en": "yes (si without the accent means if)",
        "emoji": "✅",
        "say": "sí",
        "note": "Sí with an accent means yes; si without it means if. They sound the same."
       },
       {
        "id": "es-sp-mark-tu",
        "kind": "mark",
        "text": "tú",
        "roman": "too",
        "en": "you (tu without the accent means your)",
        "emoji": "🫵",
        "say": "tú",
        "note": "Tú with an accent means you; tu without it means your. They sound the same."
       }
      ]
     }
    ]
   },
   {
    "id": "es-sp-reading",
    "title": "Read real words",
    "tagline": "Use your new sounds on words you know.",
    "lessons": [
     {
      "id": "es-sp-reading-1",
      "title": "Read greetings",
      "words": [
       {
        "id": "es-sp-read-es-b1-l1-0",
        "kind": "reading",
        "audioId": "es-b1-l1-0",
        "text": "Hola",
        "en": "Hello",
        "emoji": "👋",
        "accept": [
         "hi",
         "hiya"
        ]
       },
       {
        "id": "es-sp-read-es-b1-l1-1",
        "kind": "reading",
        "audioId": "es-b1-l1-1",
        "text": "Gracias",
        "en": "Thank you",
        "emoji": "🙏",
        "accept": [
         "thanks",
         "thank you very much"
        ]
       },
       {
        "id": "es-sp-read-es-b1-l1-4",
        "kind": "reading",
        "audioId": "es-b1-l1-4",
        "text": "Perdón",
        "en": "Sorry",
        "emoji": "😔",
        "accept": [
         "excuse me",
         "pardon",
         "pardon me"
        ]
       },
       {
        "id": "es-sp-read-es-b1-l2-0",
        "kind": "reading",
        "audioId": "es-b1-l2-0",
        "text": "¿Qué tal?",
        "en": "How are you?",
        "emoji": "🙂",
        "accept": [
         "how's it going",
         "how are things",
         "how are you doing"
        ]
       },
       {
        "id": "es-sp-read-es-b1-l2-4",
        "kind": "reading",
        "audioId": "es-b1-l2-4",
        "text": "Adiós",
        "en": "Goodbye",
        "emoji": "👋",
        "accept": [
         "bye",
         "bye bye"
        ]
       }
      ]
     },
     {
      "id": "es-sp-reading-2",
      "title": "Read numbers",
      "words": [
       {
        "id": "es-sp-read-es-n1-l1-0",
        "kind": "reading",
        "audioId": "es-n1-l1-0",
        "text": "uno",
        "en": "One",
        "emoji": "1️⃣",
        "accept": [
         "1"
        ]
       },
       {
        "id": "es-sp-read-es-n1-l1-1",
        "kind": "reading",
        "audioId": "es-n1-l1-1",
        "text": "dos",
        "en": "Two",
        "emoji": "2️⃣",
        "accept": [
         "2"
        ]
       },
       {
        "id": "es-sp-read-es-n1-l1-2",
        "kind": "reading",
        "audioId": "es-n1-l1-2",
        "text": "tres",
        "en": "Three",
